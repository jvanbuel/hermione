// Example devcontainer for a Hermione-observed course.
//
// A teacher commits this (and ../.hermione.json) to the course repository. When
// a student opens it in a devcontainer, the Hermione extension reports their
// file activity and every integrated terminal is transparently recorded — all
// scoped to this course via HERMIONE_TOKEN (the course enrollment token).
{
  "name": "CS 101",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",

  "containerEnv": {
    // Where the course's Hermione backend lives.
    "HERMIONE_BACKEND": "https://hermione.example.edu:50051",
    // The course enrollment token (from POST /api/admin/courses). This is what
    // makes the data land in *this* course.
    "HERMIONE_TOKEN": "REPLACE_WITH_COURSE_ENROLLMENT_TOKEN",
    // Identify the student. Falls back to the host username; a teacher could
    // instead derive this from the LMS or the student's git identity.
    "HERMIONE_STUDENT": "${localEnv:USER}"
  },

  // Install the `hermione` recorder binary into the container. Point this at
  // however you distribute the binary for your course.
  "postCreateCommand": "curl -fsSL https://hermione.example.edu/install.sh | sh",

  "customizations": {
    "vscode": {
      "extensions": [
        // The Hermione editor-activity extension (publish it, or reference a vsix).
        "hermione.hermione-vscode"
      ],
      "settings": {
        // Make every integrated terminal a recorded one by using the recorder
        // as the shell. `hermione` with no command spawns the student's shell.
        "terminal.integrated.defaultProfile.linux": "hermione",
        "terminal.integrated.profiles.linux": {
          "hermione": { "path": "hermione" }
        }
      }
    }
  }
}
