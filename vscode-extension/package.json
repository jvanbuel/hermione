{
  "name": "hermione-vscode",
  "displayName": "Hermione Classroom",
  "description": "Reports the student's active file and exercise to the Hermione backend for live intervention and time-on-task analysis.",
  "version": "0.1.0",
  "publisher": "lightcone",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/jvanbuel/hermione.git",
    "directory": "vscode-extension"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Education",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "hermione.start",
        "title": "Hermione: Start Reporting"
      },
      {
        "command": "hermione.stop",
        "title": "Hermione: Stop Reporting"
      },
      {
        "command": "hermione.setStudent",
        "title": "Hermione: Set Student Identifier"
      },
      {
        "command": "hermione.askAssistant",
        "title": "Hermione: Ask Assistant"
      }
    ],
    "configuration": {
      "title": "Hermione",
      "properties": {
        "hermione.serverUrl": {
          "type": "string",
          "default": "http://localhost:8080",
          "description": "Base URL of the Hermione backend HTTP server."
        },
        "hermione.student": {
          "type": "string",
          "default": "",
          "description": "Student identifier. Defaults to $HERMIONE_STUDENT or the OS username."
        },
        "hermione.token": {
          "type": "string",
          "default": "",
          "description": "Bearer token to authenticate with the Hermione backend. Defaults to $HERMIONE_TOKEN."
        },
        "hermione.heartbeatSeconds": {
          "type": "number",
          "default": 15,
          "minimum": 5,
          "description": "How often to report that the current file is still active (seconds)."
        },
        "hermione.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Whether to report file activity on startup."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run bundle",
    "compile": "tsc -p ./ --noEmit",
    "bundle": "esbuild src/extension.ts --bundle --platform=node --target=node18 --format=cjs --external:vscode --external:bufferutil --external:utf-8-validate --outfile=out/extension.js",
    "watch": "tsc -watch -p ./ --noEmit",
    "package": "vsce package -o hermione-vscode.vsix"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@types/ws": "^8.5.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.4.0"
  }
}
